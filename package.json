{
  "name": "utc-toeic-oracle",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "build": "npm run build --workspace web && dotnet build server/Toeic.Api/Toeic.Api.csproj -c Release",
    "test": "node --test tests/*.test.mjs",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "admin:demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/admin-demo.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish.ps1",
    "serve": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve.ps1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
